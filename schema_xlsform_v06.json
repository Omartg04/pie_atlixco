      "label": "Resultado de la entrevista",
      "required": "yes",
      "relevant": "${contacto_inicial} = 'acepta'",
      "calculation": null
    },
    {
      "type": "calculate",
      "name": "resultado",
      "label": null,
      "required": null,
      "relevant": null,
      "calculation": "if(${contacto_inicial} = 'casa_sola', 'casa_sola', if(${contacto_inicial} = 'rechazo', 'rechazo', ${estado_entrevista}))"
