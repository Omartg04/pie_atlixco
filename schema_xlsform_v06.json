      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "end_group",
      "name": null,
      "label": null,
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one sexo",
      "name": "sexo_observado",
      "label": "Sexo (apreciación del brigadista; no preguntar)",
      "required": null,
      "relevant": "${contacto_inicial} = 'acepta'",
      "calculation": null
    },
    {
      "type": "select_one estado",
