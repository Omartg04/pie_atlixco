    {
      "type": "note",
      "name": "introduccion",
      "label": "Brigada de la Defensa de la Transformación y Soberanía del General Arturo Solano. No mencionar candidaturas ni a ningún otro aspirante. Una visita = un registro",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one brigadistas",
      "name": "brigadista",
      "label": "Nombre del brigadista",
      "required": "yes",
      "relevant": null,
      "calculation": null
    },
    {
      "type": "text",
      "name": "brigadista_otro",
      "label": "Escribe tu nombre",
      "required": "yes",
      "relevant": "${brigadista} = 'B99'",
      "calculation": null
    },
    {
      "type": "calculate",
      "name": "brigadista_nombre",
      "label": null,
      "required": null,
      "relevant": null,
      "calculation": "if(${brigadista} = 'B99', ${brigadista_otro}, jr:choice-name(${brigadista}, '${brigadista}'))"
    },
    {
      "type": "select_one secciones",
      "name": "seccion_declarada",
      "label": "Sección electoral operativa",
      "required": "yes",
      "relevant": null,
      "calculation": null
    },
    {
      "type": "calculate",
      "name": "seccion_electoral",
      "label": null,
      "required": null,
      "relevant": null,
      "calculation": "number(${seccion_declarada})"
    },
    {
      "type": "geopoint",
      "name": "gps",
      "label": "Ubicación GPS de la visita",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "note",
      "name": "saludo",
      "label": "Buenas tardes. Soy __________, vecino de Atlixco y brigadista para los COMITÉS DE DEFENSA DE LA TRANSFORMACIÓN Y LA SOBERANÍA NACIONAL en ATLIXCO. Venimos a platicarle sobre los logros de la Cuarta Transformación y la organización de Morena en su colonia. ¿Me regala dos minutos?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one contacto",
      "name": "contacto_inicial",
      "label": "Resultado del contacto en la visita",
      "required": "yes",
      "relevant": null,
      "calculation": null
    },
    {
      "type": "begin_group",
      "name": "entrevista",
      "label": "Preguntas y registro",
      "required": null,
      "relevant": "${contacto_inicial} = 'acepta'",
      "calculation": null
    },
    {
      "type": "select_one sinor",
      "name": "q01_reconocimiento",
      "label": "¿Ha escuchado hablar de Arturo Solano, «El General»?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one sinor",
      "name": "q02_bienestar",
      "label": "¿Sabía que la Cuarta Transformación ha llevado los programas de Bienestar a millones de familias y defiende que México decida su propio destino, sin presiones de otros países?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one sinor",
      "name": "q03_comites_120",
      "label": "¿Sabía que el General Arturo Solano ha trabajado con los vecinos de Atlixco organizando más de 120 comités comunitarios en colonias y comunidades del municipio?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one sinosabe",
      "name": "q04_honestidad",
      "label": "Por su trayectoria al servicio del país como General, ¿considera que es una persona honesta y comprometida con el pueblo de Atlixco?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one sinosabe",
      "name": "q05_coordinacion",
      "label": "Morena integrará en Atlixco los Comités de Defensa de la Transformación y la Soberanía Nacional. ¿Le gustaría que el General Arturo Solano los coordine?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one problemas",
      "name": "q06_problema",
      "label": "En Atlixco el pueblo manda porque es soberano. Para usted, ¿cuál es el problema más importante de su colonia?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one participacion",
      "name": "q07_participacion",
      "label": "¿Le gustaría participar en el Comité de Defensa de la Transformación de su colonia?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "begin_group",
      "name": "datos_contacto",
      "label": "Contacto voluntario",
      "required": null,
      "relevant": "${q07_participacion} = 'si' or ${q07_participacion} = 'mas_adelante'",
      "calculation": null
    },
    {
      "type": "note",
      "name": "avisopriv",
      "label": "¿Me da un WhatsApp para invitarle a las reuniones de su colonia? Solo para eso, y lo borramos cuando nos pida. El aviso de privacidad está en este volante.\nAntes de continuar, entregar el aviso de privacidad y verificar que identifique al responsable y el mecanismo para retirar el consentimiento.",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one sino",
      "name": "autoriza_avisos",
      "label": "¿Autoriza recibir avisos por WhatsApp para las reuniones de su colonia?",
      "required": "yes",
      "relevant": null,
      "calculation": null
    },
    {
      "type": "text",
      "name": "whatsapp",
      "label": "Número de WhatsApp (10 dígitos)",
      "required": "yes",
      "relevant": "${autoriza_avisos} = 'si'",
      "calculation": null
    },
    {
      "type": "end_group",
      "name": null,
      "label": null,
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "select_one edad",
      "name": "q08_rango_edad",
      "label": "¿En qué rango de edad está?",
      "required": null,
      "relevant": null,
      "calculation": null
    },
    {
      "type": "note",
      "name": "despedida",
